#!/usr/bin/env bash
set -euo pipefail

# OCI OS one-shot dispatcher for Bucket LS

# === framework for relative paths in bash scripts =======================
#
# CONTRACT: every path produced here is PHYSICAL — all symlinks resolved,
# `..` resolved by traversal, never lexically. Containment tests elsewhere
# must therefore only ever compare canonical-to-canonical.
#
# Hard deps: bash >= 3.2 (macOS default ok), POSIX dirname/basename,
# readlink with NO flags (universal, incl. pre-12.3 macOS).
# realpath / readlink -f are used opportunistically, never required.

# --- physical directory containing a path (builtins only) ---------------
__phys_dir() {
    # CDPATH='' : an inherited CDPATH can redirect `cd` AND print to stdout
    ( CDPATH='' cd -P -- "$(dirname -- "$1")" && pwd -P )
}

# --- physical directory of a script --------------------------------------
# Call from the TOP LEVEL of the script to locate, passing its own source:
#
#     __PREFIX__=$(__script_dir "${BASH_SOURCE[0]:-$0}") || exit 1
#     export __PREFIX__
#
# (Pass it in: inside a function, BASH_SOURCE[0] names the file where the
# FUNCTION is defined — this library — not the caller.)
__script_dir() {
    local src=$1 dir hops=0
    while [ -h "$src" ]; do                      # resolve file-level chain
        dir=$(__phys_dir "$src")        || return 1
        src=$(readlink -- "$src")       || return 1
        [[ $src != /* ]] && src=$dir/$src        # relative link targets
        if (( ++hops > 40 )); then               # realpath(3) gives ELOOP;
            printf '__script_dir: symlink loop at %s\n' "$1" >&2
            return 1                             # a bare loop spins forever
        fi
    done
    __phys_dir "$src"
}

# --- general-purpose physical canonicalizer ------------------------------
# For EXISTING paths (our use case: the script and resolved binaries always
# exist; this sidesteps the -e/-E divergence between implementations).
__realpath() {
    [ $# -eq 1 ] || { printf 'usage: __realpath <path>\n' >&2; return 2; }
    # Flag-less realpath = physical semantics on GNU, BSD, macOS 13+,
    # busybox, and uutils alike. The flags are where portability dies.
    if command -v realpath >/dev/null 2>&1; then
        realpath -- "$1"; return
    fi
    if command -v grealpath >/dev/null 2>&1; then   # Homebrew coreutils
        grealpath -- "$1"; return
    fi
    if readlink -f -- / >/dev/null 2>&1; then       # macOS >= 12.3
        readlink -f -- "$1"; return
    fi
    # Pure-shell fallback — same physical semantics as the branches above.
    local p=$1 dir hops=0
    if [ -d "$p" ]; then ( CDPATH='' cd -P -- "$p" && pwd -P ); return; fi
    while [ -h "$p" ]; do
        dir=$(__phys_dir "$p")    || return 1
        p=$(readlink -- "$p")     || return 1
        [[ $p != /* ]] && p=$dir/$p
        (( ++hops > 40 )) && { printf '__realpath: symlink loop\n' >&2; return 1; }
    done
    dir=$(__phys_dir "$p") || return 1
    printf '%s/%s\n' "${dir%/}" "$(basename -- "$p")"   # %/: avoid '//x' at root
}

# --- location resolver ----------------------------------------------------
# Sets __TARGET__ (physical path of the binary) and __MODE__ (internal if
# it lives under $__PREFIX__, else external). Fails loudly if not found —
# "not found" must never default to internal.
__resolve_target() {
    local found
    found=$(type -P "$1") || {                  # PATH files only; immune to
        printf 'error: %s: not found in PATH\n' "$1" >&2   # functions/aliases
        return 127
    }
    __TARGET__=$(__realpath "$found") || return 1
    # Glob prefix-match: anchored at the front, no regex metachar surprises.
    if [[ $__TARGET__ == "$__PREFIX__"/* ]]; then
        __MODE__=internal
    else
        __MODE__=external
    fi
}

__resolve_prefix() {
    __PREFIX__=$(__script_dir "${BASH_SOURCE[0]}") || return 1 
}


# === dispatcher script ==================================================

# ---- optional args: set defaults up front ----
threads=8
process=1
nodes=1
outfile="-"

# ---- mandatory args: leave unset (empty) ----
prefix=""

usage() {
  cat >&2 <<EOF
Usage: ${0##*/} --prefix=VALUE [options]

Required:
  --prefix=VALUE      root of the directory tree to stat

Optional:
  --threads=VALUE     number of threads    (default: ${threads})
  --process=VALUE     number of processes  (default: ${process})
  --nodes=VALUE       number of processes  (default: ${nodes})
  --outfile=VALUE     output file to send results to (default: stdout)
  -h, --help          show this help
EOF
  exit 1
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --prefix=*)    prefix="${1#*=}"    ;;
    --outfile=*)   outfile="${1#*=}"   ;;
    --threads=*)   threads="${1#*=}"   ;;
    --process=*)   process="${1#*=}"   ;;
    --nodes=*)     nodes="${1#*=}"     ;;
    -h|--help)     usage               ;;
    --*)           echo "Unknown option: $1" >&2; usage ;;
    *)             echo "Unexpected argument: $1" >&2; usage ;;
  esac
  shift
done

# ---- validate mandatory args ----
[[ -n "$prefix" ]] || { echo "Error: --prefix is required" >&2; usage; }

#  ---- validate mandatory args ----
__resolve_prefix
__resolve_target ${__PREFIX__}/pipelines/stat.py

# ---- slurm run ----
head_node=$(scontrol show hostnames "$SLURM_JOB_NODELIST" | head -1)   

srun --exact -N 1 -n 1 -w $head_node                                      \
    uv run --project=${__PREFIX__} python ${__TARGET__} bus               \
    --wait 60                                                             \
    --work 0.0.0.0:9101 --completions 0.0.0.0:9102 --results 0.0.0.0:9103 &
bus_pid=$!

srun --exact -N $nodes -n $process --exclude $head_node        \
    uv run --project=${__PREFIX__} python ${__TARGET__} worker \
        --threads $threads --wait 60                           \
        --work $head_node:9101                                 \
        --completions $head_node:9102                          \
    --results $head_node:9103                              &
worker_pid=$!

srun --exact -N 1 -n 1 -w $head_node                                      \
    uv run --project=${__PREFIX__} python ${__TARGET__} collect           \
    -o $outfile --wait 60                                                 \
    --work 0.0.0.0:9101 --completions 0.0.0.0:9102 --results 0.0.0.0:9103 &
collector_pid=$!

children="$bus_pid $worker_pid $collector_pid"

is_active() {
    [ -n "$1" ] && kill -0 "$1" 2>/dev/null
}

terminate_owned() {
    for pid in $children "$coordinator_pid"; do
        if is_active "$pid"; then
            kill "$pid" 2>/dev/null || true
        fi
    done
}

cleanup() {
    status=$?
    trap - EXIT INT TERM
    terminate_owned
    for pid in $children "$coordinator_pid"; do
        wait "$pid" 2>/dev/null || true
    done
    exit "$status"
}
on_interrupt() { exit 130; }
on_terminate() { exit 143; }
trap cleanup EXIT
trap on_interrupt INT
trap on_terminate TERM

coordinator_pid=""
coord_done=0
collector_done=0
bus_done=0
worker_done=0
coordinator_status=0
collector_status=0
bus_status=0
worker_status=0

srun --exact -N 1 -n 1 -w "$head_node"                         \
    uv run --project=${__PREFIX__} python ${__TARGET__} coordinator       \
    "$prefix" --wait 60                                                   \
    --work 0.0.0.0:9101 --completions 0.0.0.0:9102 --results 0.0.0.0:9103 &
coordinator_pid=$!

reap_role() {
    role_pid=$1
    role_done=$2
    role_status=$3
    if [ "$(eval "printf '%s' \"\$$role_done\"")" -eq 0 ] && ! is_active "$role_pid"; then
        if wait "$role_pid"; then
            code=0
        else
            code=$?
        fi
        eval "$role_status=$code"
        eval "$role_done=1"
    fi
}

while :; do
    reap_role "$coordinator_pid" coord_done coordinator_status
    reap_role "$collector_pid" collector_done collector_status
    reap_role "$bus_pid" bus_done bus_status
    reap_role "$worker_pid" worker_done worker_status

    if [ "$coordinator_status" -ne 0 ] || [ "$collector_status" -ne 0 ] || \
       [ "$bus_status" -ne 0 ] || [ "$worker_status" -ne 0 ]; then
        break
    fi
    if [ "$coord_done" -eq 1 ] && [ "$collector_done" -eq 1 ]; then
        break
    fi
    sleep 0.1
done

if [ "$coordinator_status" -ne 0 ]; then
    exit "$coordinator_status"
fi
if [ "$collector_status" -ne 0 ]; then
    exit "$collector_status"
fi
if [ "$bus_status" -ne 0 ]; then
    exit "$bus_status"
fi
if [ "$worker_status" -ne 0 ]; then
    exit "$worker_status"
fi
exit 0
